{
  "name": "core",
  "version": "0.5.0",
  "private": true,
  "description": "quickli Python core library package",
  "scripts": {
    "test": "python -m pytest",
    "lint": "python -m ruff check .",
    "format:check": "python -m ruff format --check .",
    "coverage": "python -m pytest --cov=quickli --cov-report=term-missing --cov-report=xml --cov-fail-under=80",
    "build": "python -m build --sdist --wheel"
  }
}
